{
  "ConnectionStrings": {
    "DefaultConnection": "Server=Logic;Database=Hospital;User ID=smart;Password=;TrustServerCertificate=true;MultipleActiveResultSets=true",
    "AccountingConnection": "Server=Logic;Database=Accounting;User ID=smart;Password=;TrustServerCertificate=true;MultipleActiveResultSets=true",
    "smartHRConnection": "Server=Logic;Database=Hospital;User ID=smart;Password=;TrustServerCertificate=true;MultipleActiveResultSets=true"
  },

  "DatabaseMigrations": {
    "Enabled": true
  },

  "DatabaseSeeding": {
    "Enabled": true
  },

  "BillingSync": {
    "EnableMessageBus": false
  },

  "LegacyReportService": {
    "BaseUrl": "https://localhost:44369",
    "AccountingRoutePrefix": "api/Reports",
    "TimeoutSeconds": 120,
    "ApiKey": ""
  },

  "RabbitMQ": {
    "Host": "localhost",
    "Username": "guest",
    "Password": ""
  },

  "SmtpConfig": {
    "Host": "mail.logicversion.ng",
    "Port": 8889,
    "UseSSL": false,
    "Name": "VCP Aesthetic Clinic",
    "Username": "noreply@logicversion.ng",
    "EmailAddress": "noreply@logicversion.ng",
    "Password": ""
  },

  "WhatsAppConfig": {
    "Enabled": false,
    "AccountSid": "",
    "AuthToken": "",
    "FromPhoneNumber": "+1234567890",
    "MaxRetries": 3
  },

  "SmsConfig": {
    "Enabled": false,
    "AccountSid": "",
    "AuthToken": "",
    "FromPhoneNumber": "+1234567890",
    "MaxRetries": 3
  },

  "SmsMessageTemplateConfig": {
    "AppointmentTemplate": "Hello {PatientName}, your appointment has been {Action}. Date: {Date}, Time: {Time}, Clinic: {Clinic}. Please contact us if you need any changes.",
    "AttendanceTemplate": "{PatientName}, thank you for choosing us as your preferred healthcare provider. your satisfaction is our priority",
    "BirthdayTemplate": "Happy Birthday {PatientName}! We wish you good health, joy and wellness always."
  },

  "AppointmentNotificationConfig": {
    "EnableSms": true
  },

  "AttendanceNotificationConfig": {
    "EnableSms": true
  },

  "BirthdayNotificationConfig": {
    "EnableSms": false
  },

  "ClientBaseUrl": "http://localhost:4200",

  "OIDC": {
    "Certificates": {
      "Path": "",
      "Password": ""
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "AestheticEMR.Server"
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LogRetentionConfig": {
    "Enabled": true,
    "RetentionDays": 7,
    "CleanupIntervalHours": 24
  },
  "AllowedHosts": "*"
}
